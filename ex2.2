import math

# Câu 1
radius = 5
volume = (4 / 3) * math.pi * (radius ** 3)

# Câu 2
cover_price = 24.95
discount = 0.40
discounted_price = cover_price * (1 - discount)

copies = 60
shipping_first = 3.00
shipping_rest = 0.75
total_shipping = shipping_first + shipping_rest * (copies - 1)

total_cost = (discounted_price * copies) + total_shipping

# Câu 3
start_hour = 6
start_minute = 52
start_time_seconds = (start_hour * 3600) + (start_minute * 60)

easy_pace_seconds = (8 * 60) + 15
tempo_pace_seconds = (7 * 60) + 12

total_run_seconds = (2 * easy_pace_seconds) + (3 * tempo_pace_seconds)
end_time_seconds = start_time_seconds + total_run_seconds

end_hour = end_time_seconds // 3600
end_minute = (end_time_seconds % 3600) // 60
